[Unit]
Description=Windmill LAN image relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__WINDMILL_USER__
WorkingDirectory=__WINDMILL_DIR__
ExecStart=__WINDMILL_DIR__/relay.sh
Restart=always
RestartSec=5
EnvironmentFile=__WINDMILL_DIR__/.env

[Install]
WantedBy=multi-user.target
