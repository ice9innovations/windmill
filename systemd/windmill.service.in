[Unit]
Description=Windmill API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__WINDMILL_USER__
WorkingDirectory=__WINDMILL_DIR__
ExecStart=__WINDMILL_DIR__/windmill_venv/bin/python api.py
Restart=always
RestartSec=10
EnvironmentFile=__WINDMILL_DIR__/.env

[Install]
WantedBy=multi-user.target
