[Unit]
Description=Windmill worker monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__WINDMILL_USER__
WorkingDirectory=__WINDMILL_DIR__
ExecStart=__WINDMILL_DIR__/windmill.sh monitor 30
Restart=always
RestartSec=10
EnvironmentFile=__WINDMILL_DIR__/.env

[Install]
WantedBy=multi-user.target
